# Database — required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Auth — required
AUTH_SECRET=generate-with-openssl-rand-base64-32-minimum-32-characters
NEXTAUTH_URL=http://localhost:3000

# AI Providers — at least one must be set
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...   # optional
AI_PROVIDER_ORDER=gemini,groq,claude

# Email (Resend) - required in production for password reset
# Without RESEND_API_KEY, development logs the reset link to the console instead.
RESEND_API_KEY=re_...
EMAIL_FROM=Deutsch Lernen <no-reply@your-domain.com>

# Redis — optional locally (pick one)
# Option A: standard ioredis connection (local / Redis Cloud / Railway)
REDIS_URL=redis://localhost:6379

# Option B: Upstash REST (recommended for Vercel — set both)
# UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Without Redis: dev skips rate limiting, production uses per-instance in-memory limits.

# Seed — create demo accounts (publicly known passwords). NEVER enable in production.
# SEED_DEMO_USERS=true

# Database — wajib
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Auth — wajib
AUTH_SECRET=generate-dengan-openssl-rand-base64-32-minimum-32-karakter
NEXTAUTH_URL=http://localhost:3000

# AI Providers — minimal satu harus diisi
GEMINI_API_KEY=AIza...
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...   # opsional
AI_PROVIDER_ORDER=gemini,groq,claude

# Redis — opsional lokal (pilih salah satu)
# Opsi A: koneksi ioredis standar (lokal / Redis Cloud / Railway)
REDIS_URL=redis://localhost:6379

# Opsi B: Upstash REST (direkomendasikan untuk Vercel — set keduanya)
# UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<token>
# Jika tidak ada Redis sama sekali, app tetap berjalan tanpa rate limiting.

# Google TTS — opsional
NEXT_PUBLIC_GOOGLE_TTS_API_KEY=AIza...
